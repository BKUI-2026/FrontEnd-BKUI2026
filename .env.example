# Template env untuk FrontEnd-BKUI2026.
# Copy ke .env.local lalu isi nilainya. JANGAN commit .env.local.
#
# Prefix NEXT_PUBLIC_ artinya nilainya ikut ter-bundle ke browser dan bisa
# dibaca siapa saja. JANGAN pernah taruh secret di sini — Google Client Secret
# ada di sisi BE, bukan FE.

# --- Backend API ---
# Base URL API BE, sudah termasuk prefix /api/v1.
#
# Lokal  : BE jalan di port 3000, FE di 3001 (lihat FE-0002).
# Produksi: https://api.uibedahkampus.com/api/v1
#           Di Vercel, isi variabel ini lewat Project Settings > Environment
#           Variables untuk environment Production & Preview. Jangan andalkan
#           berkas ini — .env.example tidak ikut terbaca saat build di Vercel.
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000/api/v1"

# --- Google SSO (client-side) ---
# Client ID saja, BUKAN client secret. Lihat integrations/google-sso-client.md
# Samakan dengan yang didaftarkan di BE.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# --- Yesplis (redirect keluar, TIDAK ada checkout internal) ---
# Tiket sudah punya URL resmi. Merchandise tetap dinonaktifkan selama kosong.
NEXT_PUBLIC_YESPLIS_TICKET_URL="https://www.yesplis.com/event/bedah-kampus-ui-2026"
NEXT_PUBLIC_YESPLIS_MERCH_URL=""

# --- Hitung mundur Hero ---
# ISO 8601 wajib mencantumkan timezone. Contoh ini memakai WIB (UTC+07:00).
NEXT_PUBLIC_BKUI_COUNTDOWN_TARGET="2026-12-31T00:00:00+07:00"
